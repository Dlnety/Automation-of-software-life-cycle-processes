FROM python:3.12-slim

WORKDIR /scan

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt pylint==4.1.3

COPY app.py db.py ./
COPY ci/demo.py ./

CMD ["sh", "-c", "pylint --exit-zero --score=n app.py db.py demo.py; echo '--- BLOCKER CHECK ---'; pylint --disable=all --enable=F,E0001,E0602 --score=n app.py db.py demo.py"]
